# =====================================================================
# PC Remote Sentinel & Command Center Configuration
# =====================================================================

# 1. Telegram Bot Token from @BotFather (Required)
# Open Telegram -> @BotFather -> /newbot -> Copy API Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Authorized Telegram User IDs (Required for Security)
# Send /start to @userinfobot to find your numeric ID (e.g. 987654321)
# Comma-separate multiple IDs if you want to allow more than one account.
AUTHORIZED_USER_IDS=0

# 3. Local Storage Paths
RECORDINGS_DIR=./recordings
DOWNLOADS_DIR=./downloads

# 4. Optional Passcode / PIN Login Security (Leave empty to disable PIN requirement)
# When set, authorized users must enter /login <PIN> before executing commands.
BOT_PIN=
SESSION_TIMEOUT_MINS=60

# 5. Remote Screen Casting (Global Internet Streaming via Cloudflare Tunnel)
ENABLE_PUBLIC_TUNNEL=true
STREAM_PORT=8585
