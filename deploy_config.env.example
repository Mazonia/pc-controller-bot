# =====================================================================
# PC Remote Sentinel — Multi-PC Fleet Deployment Configuration Template
# =====================================================================
# Copy this file to `deploy_config.env` on your USB pendrive or local folder.
# The installer reads these settings when deploying to each PC.

# 1. Shared Secret Key
# Encrypts all control traffic and authenticates communication between Bot and PCs.
FLEET_SECRET=your-random-shared-secret-key-here

# 2. Telegram Bot Configuration (from your main .env)
# Allows each PC to directly upload screenshots, webcams, and recordings to Telegram.
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_IDS=your_telegram_user_id_here

# 3. Cloud Relay Settings (MQTT over TLS)
# Works across LAN, Wi-Fi, Mobile Hotspot, 4G/5G Cellular, CGNAT, and Firewalls.
# Uses free public TLS broker by default (all payloads encrypted with FLEET_SECRET).
MQTT_BROKER=broker.emqx.io
MQTT_PORT=8883
MQTT_USE_TLS=true

# 4. Local LAN Ports (Dual-mode)
AGENT_PORT=9010
STREAM_PORT=8585
